# Development-only PostgreSQL settings. Copy this file to .env before running
# Docker Compose. Do not commit the resulting .env file.
POSTGRES_DB=scad_inventory
POSTGRES_USER=scad_inventory
POSTGRES_PASSWORD=scad_inventory_dev_password
POSTGRES_PORT=5432
API_PORT=5097

# Development-only JWT settings. Replace the signing key outside local use.
JWT_ISSUER=scad-inventory-api
JWT_AUDIENCE=scad-inventory-ui
JWT_SIGNING_KEY=development-only-signing-key-change-before-production
JWT_EXPIRATION_MINUTES=60
